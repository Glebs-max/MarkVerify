<Window x:Class="LabelDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabelDesigner"
        d:DataContext="{d:DesignInstance Type=local:DesignerViewModel}"
        mc:Ignorable="d" FontFamily="Bahnschrift" FontSize="17"
        Title="Label Designer" Height="720" Width="1280">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="MediumVioletRed" FontFamily="Bahnschrift" FontSize="17">
            <MenuItem Header="Открыть" Click="FileOpen_Click" Padding="15,4,15,4" Foreground="White"/>
            <MenuItem Header="Сохранить" Click="FileSave_Click" Padding="15,4,15,4" Foreground="White"/>
            <MenuItem Header="Выход" Click="FileExit_Click" Padding="15,4,15,4" Foreground="White"/>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" MinWidth="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="140"/>
            </Grid.ColumnDefinitions>

            <local:DesignerToolbox/>
            
            <GridSplitter Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True"
                Background="MediumVioletRed"
                Width="5"/>

            <local:DesignerCanvas x:Name="DesignerCanvas" Background="LightSalmon" Grid.Column="2" Panel.ZIndex="-1"/>

            <GridSplitter Grid.Column="3"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"
                  Background="MediumVioletRed"
                  Width="5"/>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <local:PropertiesPanel x:Name="PropertiesPanel" Background="#F4F4F4" DataContext="{Binding PropertiesTarget}"/>
                <GridSplitter Grid.Row="1" ResizeDirection="Rows"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True"
                    Background="MediumVioletRed"
                    Height="5"/>
                <local:DesignerExplorer Grid.Row="2"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
