<UserControl x:Class="WpfApp_IC.Controls.VirtualKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp_IC.Controls"
             xmlns:models="clr-namespace:WpfApp_IC.Models"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=models:KeyboardKey}">
    <Border Width="55" Height="55" Background="White" Cursor="Hand" MouseDown="Key_Click">
        <TextBlock Text="{Binding KeyValue}" FontSize="24" VerticalAlignment="Center" TextAlignment="Center"/>
    </Border>
</UserControl>
