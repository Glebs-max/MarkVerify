<Window x:Class="WpfApp_IC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:WpfApp_IC.Pages"
        xmlns:vm="clr-namespace:WpfApp_IC.ViewModels"
        xmlns:designer="clr-namespace:LabelDesigner;assembly=LabelDesigner"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d" Title="Честный Знак" Icon='/Assets/fair mark.png'
        FontFamily="Bahnschrift" FontSize="17"
        Height="1024" Width="1280" WindowState="Maximized">
    <ContentPresenter Content="{Binding CurrentViewModel}">
        <ContentPresenter.Resources>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <pages:Home/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <pages:Products/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabelPreviewViewModel}">
                <pages:LabelPreview/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabelingViewModel}">
                <pages:Labeling/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <pages:Settings/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CameraViewModel}">
                <pages:CameraBasic/>
            </DataTemplate>
        </ContentPresenter.Resources>
    </ContentPresenter>
</Window>
