<Window x:Class="WpfApp_IC.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Views="clr-namespace:WpfApp_IC.Views"
        xmlns:vm="clr-namespace:WpfApp_IC.ViewModels"
        xmlns:designer="clr-namespace:LabelDesigner;assembly=LabelDesigner"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d" Title="Честный Знак" Icon='/Assets/fair mark.png'
        FontFamily="Bahnschrift" FontSize="17" WindowStyle="None"
        Height="1024" Width="1024" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft" Background="#FFFF8834">
            <Grid Width="60" MouseDown="Fullscreen_Click" MouseEnter="Tray_MouseEnter" MouseLeave="Tray_MouseLeave">
                <Image Source="/Assets/fullscreen.png" Margin="0,5"/>
                <Border Background="White" Opacity="0"/>
            </Grid>
            <Grid Width="60" MouseDown="Minimize_Click" MouseEnter="Tray_MouseEnter" MouseLeave="Tray_MouseLeave">
                <Image Source="/Assets/minimize.png" Margin="0,5"/>
                <Border Background="White" Opacity="0"/>
            </Grid>
        </WrapPanel>
        <ContentPresenter Grid.Row="1" Content="{Binding CurrentViewModel}">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                    <Views:Home/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                    <Views:Products/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:LabelPreviewViewModel}">
                    <Views:LabelPreview/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:LabelingViewModel}">
                    <Views:Labeling/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                    <Views:Settings/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:CameraViewModel}">
                    <Views:CameraBasic/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>
    </Grid>
</Window>
