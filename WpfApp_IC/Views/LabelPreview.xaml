<UserControl x:Class="WpfApp_IC.Views.LabelPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Views="clr-namespace:WpfApp_IC.Views"
             xmlns:controls="clr-namespace:WpfApp_IC.Controls"
             xmlns:vm="clr-namespace:WpfApp_IC.ViewModels"
             xmlns:designer="clr-namespace:LabelDesigner;assembly=LabelDesigner"
             d:DataContext="{d:DesignInstance Type=vm:LabelPreviewViewModel}"
             mc:Ignorable="d" Background="#F4F4F4" FontSize="24">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <designer:DesignerCanvas Background="White" Panel.ZIndex="-1" DataContext="{Binding DesignerViewModel}"/>
            <Views:DataInput Grid.Column="1" DataContext="{Binding DesignerViewModel}"/>
        </Grid>
        <controls:VirtualKeyboard Grid.Row="1" FontFamily="Consolas" Margin="5"/>
        <Grid Margin="5" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Продолжить" Height="50" Margin="7,0" Click="PrintLabel_Click"/>
            <Button Content="Назад" Height="50" Margin="7,0" Grid.Column="1" Click="GetBack_Click"/>
        </Grid>
    </Grid>
</UserControl>
