<UserControl x:Class="WpfApp_IC.Pages.CameraBasic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:WpfApp_IC.ViewModels"
             xmlns:conv="clr-namespace:WpfApp_IC.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:CameraBasicViewModel}"
             mc:Ignorable="d" FontSize="14">
    <Grid Grid.Column="2">
        <Grid.RowDefinitions>
            <!-- Панель -->
            <RowDefinition Height="Auto"/>
            <!-- DataMatrix -->
            <RowDefinition Height="Auto"/>
            <!-- Изображение -->
            <RowDefinition Height="*"/>
            <!-- Сплиттер -->
            <RowDefinition Height="5"/>
            <!-- Логи -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель -->
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,5">
            <!-- Старт / Стоп -->
            <Button Width="30"
                    Height="30"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="StartStop_Click">
                <Path Fill="{Binding IsRunning, Converter={StaticResource StartStopColorConverter}}"
                      Stretch="Uniform"
                      Data="{Binding IsRunning, Converter={StaticResource StartStopGeometryConverter}}"/>
            </Button>

            <!-- Показать / скрыть изображение -->
            <CheckBox Style="{StaticResource ImageToggleStyle}"
                      HorizontalAlignment="Center"
                      Margin="10,0"
                      IsChecked="{Binding ShowImage}"/>

            <!-- Показать / скрыть лог -->
            <CheckBox Style="{StaticResource LogToggleStyle}"
                      HorizontalAlignment="Center"
                      Margin="10,0"
                      IsChecked="{Binding ShowLog}"/>
        </WrapPanel>

        <!-- DataMatrix -->
        <TextBox Grid.Row="1"
         Height="30"
         Margin="10,5"
         FontSize="19"
         IsReadOnly="True"
         VerticalContentAlignment="Center"
         Background="#FFF9F9F9"
         Text="{Binding DataMatrix}"
         Foreground="{Binding DataMatrixBrush}"/>

        <!-- Изображение -->
        <Border Grid.Row="2" Margin="10,5" BorderBrush="#CCC" BorderThickness="1" Visibility="{Binding ShowImage, Converter={StaticResource BoolToVisibility}}">
            <Image Stretch="Uniform" Source="{Binding Frame}"/>
        </Border>

        <!-- Горизонтальный сплиттер -->
        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="MediumVioletRed"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Логи -->
        <Border Grid.Row="4" Background="#1E1E1E" Visibility="{Binding ShowLog, Converter={StaticResource BoolToVisibility}}">
            <ListBox ItemsSource="{Binding Log}"
                     Foreground="LightGreen"
                     Background="Transparent"
                     FontSize="14"
                     Margin="10"/>
        </Border>
    </Grid>
</UserControl>
