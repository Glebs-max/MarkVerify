<UserControl x:Class="WpfApp_IC.Pages.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:WpfApp_IC.ViewModels"
             xmlns:converters="clr-namespace:WpfApp_IC.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#666666"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#2B2B2B">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#222222" Padding="24,0">
            <TextBlock Text="Настройки" Foreground="White"
                       FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="560" HorizontalAlignment="Center" Margin="0,20,0,20">

                <!-- ПРИНТЕР -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Принтер" Style="{StaticResource SectionHeader}"/>

                        <CheckBox Content="Использовать принтер"
                                  IsChecked="{Binding UsePrinter}"
                                  Style="{StaticResource Toggle}"/>

                        <StackPanel IsEnabled="{Binding UsePrinter}">
                            <TextBlock Text="IP-адрес" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PrinterIp, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}"/>

                            <TextBlock Text="Порт TextComms" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PrinterPortTextComms, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}"/>

                            <TextBlock Text="Порт ZPL Emulation" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PrinterPortZpl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MODBUS -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Modbus контроллер" Style="{StaticResource SectionHeader}"/>

                        <CheckBox Content="Использовать Modbus"
                                  IsChecked="{Binding UseModbus}"
                                  Style="{StaticResource Toggle}"/>

                        <StackPanel IsEnabled="{Binding UseModbus}">
                            <TextBlock Text="IP-адрес" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ModbusIp, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}"/>

                            <TextBlock Text="Порт" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ModbusPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- КАМЕРА -->
                <!-- Заменить блок КАМЕРЫ на этот: -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Камера" Style="{StaticResource SectionHeader}"/>

                        <CheckBox Content="Использовать камеру"
                          IsChecked="{Binding UseCamera}"
                          Style="{StaticResource Toggle}"/>

                        <StackPanel IsEnabled="{Binding UseCamera}">

                            <!-- Список найденных камер -->
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="Найти камеры"
                                        Width="140" Height="32"
                                        DockPanel.Dock="Right"
                                        Click="RefreshCameras_Click"/>
                                <TextBlock Text="Доступные камеры"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center"/>
                            </DockPanel>

                            <ListBox ItemsSource="{Binding AvailableCameras}"
                                     SelectedItem="{Binding SelectedCamera}"
                                     Height="120"
                                     Margin="0,0,0,12"
                                     Background="#4A4A4A"
                                     Foreground="White"
                                     BorderBrush="#666666">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,6">
                                                        <TextBlock FontWeight="SemiBold" Foreground="White"><Run Text="["/>
                                                            <Run Text="{Binding Index}"/><Run Text="]  "/>
                                                            <Run Text="{Binding Model}"/>
                                                        </TextBlock>
                                                        <TextBlock Foreground="#88CCFF" FontSize="12"><Run Text="IP: "/>
                                                            <Run Text="{Binding IP}"/>
                                                        </TextBlock>
                                                        <TextBlock Foreground="#AAAAAA" FontSize="11">
                                                                <Run Text="S/N: "/>
                                                                <Run Text="{Binding SerialNumber}"/>
                                                                <Run Text="   FW: "/><Run Text="{Binding Firmware}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                            <!-- Текущий индекс (только для информации) -->
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Выбран индекс: "/>
                                <Run Text="{Binding CameraDeviceIndex}"/>
                            </TextBlock>

                            <!-- Путь к IDMVS.exe -->
                            <TextBlock Text="Путь к IDMVS.exe" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                            <DockPanel Margin="0,0,0,12">
                                <Button Content="Обзор..."
                                        Width="80" Height="32"
                                        DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Click="BrowseIdmvs_Click"/>
                                <TextBox Text="{Binding IdmvsPath}"
                                         Height="32" Padding="8,4"
                                         FontSize="13" IsReadOnly="True"
                                         Background="#4A4A4A" Foreground="White"
                                         BorderBrush="#666666"/>
                            </DockPanel>

                            <!-- Папка сохранения отбракованных -->
                            <TextBlock Text="Папка отбракованных изображений"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,8,0,4"/>
                            
                            <DockPanel Margin="0,0,0,12">
                                <Button Content="Обзор..."
                                        Width="80" Height="32"
                                        DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Click="BrowseRejectImages_Click"/>
                                <TextBox Text="{Binding RejectImagesPath, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Padding="8,4"
                                         FontSize="13"
                                         Background="#4A4A4A"
                                         Foreground="White"
                                         BorderBrush="#666666"
                                         ToolTip="Папка для сохранения изображений при отбраковке"/>
                            </DockPanel>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ИНСПЕКЦИЯ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Инспекция" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Задержка отбраковщика (мс)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RejectDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Field}"/>

                        <TextBlock Text="Фильтр дребезга датчика (кол-во совпадений)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SensorFilterCount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Field}"/>

                        <TextBlock Text="Интервал опроса датчика (мс)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SensorPollIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Field}"/>
                    </StackPanel>
                </Border>

                <!-- Ошибка валидации -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF8080"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#222222" Padding="24,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="Отмена"
                        Width="110" Height="38"
                        Margin="0,0,12,0"
                        Click="Cancel_Click"/>
                <Button Content="Сохранить"
                        Width="130" Height="38"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
