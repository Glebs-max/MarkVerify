<UserControl x:Class="WpfApp_IC.Pages.VideojetErrors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp_IC.Pages"
             xmlns:wpfapp_ic="clr-namespace:WpfApp_IC"
             d:DataContext="{d:DesignInstance Type=wpfapp_ic:VideojetPrinter}"
             mc:Ignorable="d" Background="#F4F4F4" FontSize="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox ItemsSource="{Binding Errors}" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Assets/fault.png" Height="50" Margin="0,0,20,0" Stretch="Uniform"/>
                            <TextBlock Grid.Column="1" Text="{Binding Code}" Margin="0,0,20,0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="0,0,20,0" TextWrapping="Wrap" FontSize="18" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="ClearErrors" Grid.Row="1" Content="Сбросить ошибки" Height="50" Margin="20,20" Click="ClearErrors_Click"/>
    </Grid>
</UserControl>
