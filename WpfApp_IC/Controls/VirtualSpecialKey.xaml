<UserControl x:Class="WpfApp_IC.Controls.VirtualSpecialKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfApp_IC.Controls"
             xmlns:kb="clr-namespace:WpfApp_IC.Models.VirtualKeyboard"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=kb:KeyboardSpecialKey}">
    <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding Background}" BorderThickness="1" Cursor="Hand" MouseDown="Key_Click" MouseEnter="Key_Hover" MouseLeave="Key_Leave">
        <TextBlock Text="{Binding KeyDisplay}" FontSize="28" VerticalAlignment="Center" TextAlignment="Center"/>
    </Border>
</UserControl>
