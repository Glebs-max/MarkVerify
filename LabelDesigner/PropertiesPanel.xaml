<UserControl x:Class="LabelDesigner.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:props="clr-namespace:LabelDesigner.DesignerItemProperties"
             xmlns:models="clr-namespace:LabelDesigner.Models"
             d:DataContext="{d:DesignInstance Type=models:DesignerItem}"
             mc:Ignorable="d" Background="#F4F4F4">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label HorizontalAlignment="Stretch" Content="Свойства" Margin="0,0,0,7"/>
        <ScrollViewer VerticalScrollBarVisibility="Visible" Grid.Row="1">
            <ContentPresenter Content="{Binding}">
                <ContentPresenter.Resources>
                    <DataTemplate DataType="{x:Type models:TextField}">
                        <StackPanel>
                            <props:DataTypeProperties/>
                            <props:TextProperties/>
                            <props:GeneralProperties/>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:ImageField}">
                        <StackPanel>
                            <props:DataTypeProperties/>
                            <props:ImageProperties/>
                            <props:GeneralProperties/>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:DateField}">
                        <StackPanel>
                            <props:DataTypeProperties/>
                            <props:DateProperties/>
                            <props:TextProperties/>
                            <props:GeneralProperties/>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:TimeField}">
                        <StackPanel>
                            <props:DataTypeProperties/>
                            <props:TimeProperties/>
                            <props:TextProperties/>
                            <props:GeneralProperties/>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:BarcodeField}">
                        <StackPanel>
                            <props:DataTypeProperties/>
                            <props:BarcodeProperties/>
                            <props:GeneralProperties/>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:LabelArea}">
                        <props:LabelAreaProperties/>
                    </DataTemplate>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </ScrollViewer>
    </Grid>
</UserControl>
