<UserControl x:Class="WpfApp_IC.Pages.LabelPrinting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:designer="clr-namespace:LabelDesigner;assembly=LabelDesigner"
             Background="#F4F4F4"
             FontSize="24">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Статус -->
            <RowDefinition Height="*"/> <!-- Этикетка + Камера -->
            <RowDefinition Height="5"/> <!-- Сплиттер -->
            <RowDefinition Height="Auto"/> <!-- Логи -->
            <RowDefinition Height="Auto"/> <!-- Статистика -->
            <RowDefinition Height="Auto"/> <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- 1. Статус -->
        <Grid Grid.Row="0">
            <!-- твой статусбар -->
        </Grid>

        <!-- === КАМЕРА + ЛОГИ === -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ: статус + этикетка -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Статус -->
                    <RowDefinition Height="*"/>
                    <!-- Этикетка -->
                </Grid.RowDefinitions>

                <!-- === СТАТУС-БАР ПРИНТЕРА === -->
                <Grid Grid.Row="0" Height="60" Margin="0,0,0,10">
                    <Grid.Tag>
                        <MultiBinding Converter="{StaticResource PrintingStatusConverter}">
                            <Binding Path="PrintingStatus"/>
                            <Binding Path="ErrorStatus"/>
                        </MultiBinding>
                    </Grid.Tag>

                    <Grid.Background>
                        <Binding Path="Tag.StatusColor" RelativeSource="{RelativeSource Self}"/>
                    </Grid.Background>

                    <TextBlock TextAlignment="Center"
                   VerticalAlignment="Center"
                   Padding="6"
                   FontSize="28"
                   FontFamily="Bahnschrift">
                        <TextBlock.Tag>
                            <MultiBinding Converter="{StaticResource PrintingStatusConverter}">
                                <Binding Path="PrintingStatus"/>
                                <Binding Path="ErrorStatus"/>
                            </MultiBinding>
                        </TextBlock.Tag>

                        <TextBlock.Text>
                            <Binding Path="Tag.StatusText" RelativeSource="{RelativeSource Self}"/>
                        </TextBlock.Text>
                    </TextBlock>

                    <Image Height="50"
               Margin="5,5,20,5"
               HorizontalAlignment="Right"
               Cursor="Hand">
                        <Image.Tag>
                            <MultiBinding Converter="{StaticResource PrintingStatusConverter}">
                                <Binding Path="PrintingStatus"/>
                                <Binding Path="ErrorStatus"/>
                            </MultiBinding>
                        </Image.Tag>

                        <Image.Source>
                            <Binding Path="Tag.StatusIcon" RelativeSource="{RelativeSource Self}"/>
                        </Image.Source>
                    </Image>
                </Grid>

                <!-- === ЭТИКЕТКА === -->
                <designer:DesignerCanvas Grid.Row="1"
                             Background="White"
                             Preview="True"
                             DataContext="{Binding DesignerViewModel}"/>
            </Grid>


            <!-- Вертикальный сплиттер -->
            <GridSplitter Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="MediumVioletRed"
                  ResizeBehavior="PreviousAndNext"/>

            <!-- === ПРАВАЯ КОЛОНКА: КАМЕРА === -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Панель -->
                    <RowDefinition Height="Auto"/>
                    <!-- DataMatrix -->
                    <RowDefinition Height="*"/>
                    <!-- Изображение -->
                </Grid.RowDefinitions>

                <!-- Панель -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                    <!-- Старт / Стоп -->
                    <Button Width="60"
                            Height="40"
                            Margin="0,0,20,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CameraToggle_Click">
                        <Path Fill="{Binding CameraViewModel.IsRunning, Converter={StaticResource StartStopColorConverter}}"
                              Stretch="Uniform"
                              Data="{Binding CameraViewModel.IsRunning, Converter={StaticResource StartStopGeometryConverter}}"/>
                        
                    </Button>

                    <!-- Показать / скрыть изображение -->
                    <CheckBox Style="{StaticResource ImageToggleStyle}"
                      IsChecked="{Binding CameraViewModel.ShowImage}"/>

                    <!-- Показать / скрыть лог -->
                    <CheckBox Style="{StaticResource LogToggleStyle}"
                      Margin="20,0,0,0"
                      IsChecked="{Binding CameraViewModel.ShowLog}"/>
                </StackPanel>

                <!-- DataMatrix -->
                <TextBox Grid.Row="1"
                 Height="30"
                 FontSize="19"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 Background="#FFF9F9F9"
                 Margin="0,0,0,10"
                 Text="{Binding CameraViewModel.DataMatrix}"
                 Foreground="{Binding CameraViewModel.DataMatrixBrush}"/>

                <!-- Изображение -->
                <Border Grid.Row="2"
                BorderBrush="#CCC"
                BorderThickness="1"
                MaxHeight="300"
                Visibility="{Binding CameraViewModel.ShowImage, Converter={StaticResource BoolToVisibility}}">
                    <Image Stretch="Uniform"
                   Source="{Binding CameraViewModel.Frame}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. Горизонтальный сплиттер -->
        <GridSplitter Grid.Row="2"
              Height="5"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="MediumVioletRed"
              ResizeBehavior="PreviousAndNext"/>

        <!-- === ЛОГИ === -->
        <Border Grid.Row="3"
        Background="#1E1E1E"
        Visibility="{Binding CameraViewModel.ShowLog, Converter={StaticResource BoolToVisibility}}">
            <ListBox ItemsSource="{Binding CameraViewModel.Log}"
             Foreground="LightGreen"
             Background="Transparent"
             FontSize="14"
             Margin="10"
             MaxHeight="200"/>
        </Border>



        <!-- 5. Статистика -->
        <WrapPanel Grid.Row="4" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="25,20">
                <TextBlock Text="Очередь: "/>
                <TextBlock Text="{Binding VideojetPrinter.QueueSize}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="25,20">
                <TextBlock Text="Остаток: "/>
                <TextBlock Text="{Binding GTIN.CountAviable}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="25,20">
                <TextBlock Text="Верифицировано: "/>
                <TextBlock Text="{Binding Verified}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="25,20">
                <TextBlock Text="Отбраковано: "/>
                <TextBlock Text="{Binding Rejected}"/>
            </StackPanel>
        </WrapPanel>

        <!-- 6. Кнопки -->
        <WrapPanel Grid.Row="5" HorizontalAlignment="Center">
            <Button x:Name="Stop" Content="Завершить" Width="150" Height="50" Margin="25,20" Click="Stop_Click"/>
            <Button x:Name="Pause" Content="Пауза" Width="150" Height="50" Margin="25,20" Click="Pause_Click"/>
            <Button x:Name="Report" Content="Отчёт" Width="150" Height="50" Margin="25,20" IsEnabled="False"/>
            <Button x:Name="Exit" Content="Выход" Width="150" Height="50" Margin="25,20" Click="Exit_Click"/>
        </WrapPanel>

    </Grid>
</UserControl>
