<Application x:Class="WpfApp_IC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:designerconverters="clr-namespace:LabelDesigner.Converters;assembly=LabelDesigner"
             xmlns:converters="clr-namespace:WpfApp_IC.Converters"
             xmlns:conv="clr-namespace:WpfApp_IC.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:WorkStatusConverter x:Key="WorkStatusConverter"/>
            <converters:ErrorTypeConverter x:Key="ErrorTypeConverter"/>
            <converters:StartStopColorConverter x:Key="StartStopColorConverter"/>
            <converters:VideojetErrorsConverter x:Key="VideojetErrorsConverter"/>
            <converters:InspectionStatusConverter x:Key="InspectionStatusConverter"/>
            <converters:IPAddressConverter x:Key="IPAddressConverter"/>
            <designerconverters:UnitsConverter x:Key="UnitsConverter"/>
            <designerconverters:LabelAreaConverter x:Key="LabelAreaConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
