<UserControl x:Class="WpfApp_IC.Pages.CameraBasic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:WpfApp_IC.ViewModels"
             xmlns:conv="clr-namespace:WpfApp_IC.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:CameraBasicViewModel}"
             mc:Ignorable="d" FontSize="14">

    <Grid Grid.Column="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель -->
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,5">
            <Button Width="30"
                    Height="30"
                    Margin="10,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="StartStop_Click">
                <Path Fill="{Binding IsRunning, Converter={StaticResource StartStopColorConverter}}"
                      Stretch="Uniform"
                      Data="{Binding IsRunning, Converter={StaticResource StartStopGeometryConverter}}"/>
            </Button>

            <CheckBox Style="{StaticResource ImageToggleStyle}"
                      Margin="10,0"
                      IsChecked="{Binding ShowImage}"/>

            <CheckBox Style="{StaticResource LogToggleStyle}"
                      Margin="10,0"
                      IsChecked="{Binding ShowLog}"/>
        </WrapPanel>

        <!-- DataMatrix -->
        <TextBox Grid.Row="1"
                 Height="30"
                 Margin="10,5"
                 FontSize="19"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 Background="#FFF9F9F9"
                 Text="{Binding DataMatrix}"
                 Foreground="{Binding DataMatrixBrush}"/>

        <!-- Изображение -->
        <Border Grid.Row="2"
                Margin="10,5"
                BorderBrush="#CCC"
                BorderThickness="1"
                Visibility="{Binding ShowImage, Converter={StaticResource BoolToVisibility}}">
            <Image Stretch="Uniform" Source="{Binding Frame}"/>
        </Border>

        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="MediumVioletRed"/>

        <!-- Логи -->
        <Border Grid.Row="4"
                Padding="4"
                Background="#1E1E1E"
                Visibility="{Binding ShowLog, Converter={StaticResource BoolToVisibility}}">
            <ListBox x:Name="LogList"
                     ItemsSource="{Binding LogService.Entries}"
                     Background="Transparent"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     ScrollViewer.CanContentScroll="True">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}"
                                   FontFamily="Consolas"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="LightGreen"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter Property="Foreground" Value="#FFD700"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Border>
    </Grid>
</UserControl>
