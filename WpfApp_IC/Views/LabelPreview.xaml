<UserControl x:Class="WpfApp_IC.Views.LabelPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Views="clr-namespace:WpfApp_IC.Views"
             xmlns:controls="clr-namespace:WpfApp_IC.Controls"
             xmlns:vm="clr-namespace:WpfApp_IC.ViewModels"
             xmlns:designer="clr-namespace:LabelDesigner;assembly=LabelDesigner"
             d:DataContext="{d:DesignInstance Type=vm:LabelPreviewViewModel}"
             mc:Ignorable="d" Background="#F4F4F4" FontSize="24">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <designer:DesignerCanvas Background="White" Panel.ZIndex="-1" DataContext="{Binding DesignerViewModel}"/>
            <controls:VirtualKeyboard Grid.Row="1" FontFamily="Consolas"/>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Views:DataInput DataContext="{Binding DesignerViewModel}"/>
            <Button Content="Продолжить" Height="60" Margin="10,5" Click="PrintLabel_Click" Grid.Row="1"/>
            <Button Content="Назад" Height="60" Margin="10,5" Click="GetBack_Click" Grid.Row="2"/>
        </Grid>
    </Grid>
</UserControl>
