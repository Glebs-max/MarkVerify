<UserControl x:Class="WpfApp_IC.Pages.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp_IC.Pages"
             xmlns:viewmodels="clr-namespace:WpfApp_IC.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
             mc:Ignorable="d">
    <Border Padding="20" Background="#DCDCDC" Cursor="">
        <Grid>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Content="Старт"
                    Width="250"
                    Height="50"
                    FontSize="18"
                    Margin="0,0,0,20" Click="Start_Click"/>

                <Button Content="Настройки"
                    Width="250"
                    Height="50"
                    FontSize="18" Click="Settings_Click"/>

            </StackPanel>

        </Grid>
    </Border>
</UserControl>
